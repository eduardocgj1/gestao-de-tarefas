# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# Nunca suba o .env para o GitHub

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key (usada pelo servidor — nunca exponha no frontend)
# Supabase Dashboard > Settings > API > service_role
SUPABASE_KEY=your-service-role-key-here

# Anon Key (pública — enviada ao navegador via /api/config)
# Supabase Dashboard > Settings > API > anon (public)
SUPABASE_ANON_KEY=your-anon-key-here

PORT=3131
